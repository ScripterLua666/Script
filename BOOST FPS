-- АНИМАЦИЯ ЗАГРУЗКИ (7 секунд)
-- ========================================
local LOAD_TIME = 7

local startTime = tick()

local updateConn
updateConn = game:GetService("RunService").Heartbeat:Connect(function()
    local elapsed = tick() - startTime
    local progress = math.clamp(elapsed / LOAD_TIME, 0, 1)
    
    -- Плавное заполнение
    barFill.Size = UDim2.new(progress, 0, 1, 0)
    percentLabel.Text = string.format("%d%%", math.floor(progress * 100))
    
    -- Меняем цвет ближе к концу
    if progress > 0.9 then
        percentLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
    end
    
    -- Проверяем завершение
    if progress >= 1 then
        if updateConn then updateConn:Disconnect() end
        percentLabel.Text = "100%"
        
        -- Пауза перед появлением меню
        task.wait(0.3)
        
        -- Плавное исчезновение загрузки
        local fadeOut = TweenService:Create(loadFrame, TweenInfo.new(0.4), {
            BackgroundTransparency = 1
        })
        local fadeStroke = TweenService:Create(loadStroke, TweenInfo.new(0.4), {
            Transparency = 1
        })
        fadeOut:Play()
        fadeStroke:Play()
        
        for _, child in ipairs(loadFrame:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("Frame") then
                pcall(function()
                    TweenService:Create(child, TweenInfo.new(0.4), {
                        BackgroundTransparency = 1,
                        TextTransparency = 1
                    }):Play()
                end)
            end
        end
        
        task.wait(0.5)
        loadGui:Destroy()
        
        -- Показываем меню
        if _G.BaconBooster_showMenu then
            _G.BaconBooster_showMenu()
        end
    end
end)

